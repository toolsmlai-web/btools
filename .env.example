# AI Provider Configuration (add at least one)
# Choose your preferred AI provider(s) - app works with any combination

# Anthropic Claude API
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# OpenAI GPT-4 API
# Get your API key from: https://platform.openai.com/
# OPENAI_API_KEY=sk-xxxxxxxxxxxxx

# Google Gemini API
# Get your API key from: https://makersuite.google.com/
# GEMINI_API_KEY=xxxxxxxxxxxxx

# Optional: Supabase Configuration (for future database features)
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
